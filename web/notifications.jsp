<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List"%><%@page import="java.util.Map"%>
<%String username=(String)session.getAttribute("username"),role=(String)session.getAttribute("role");if(username==null){response.sendRedirect("login.jsp");return;}List<Map<String,Object>> notices=(List<Map<String,Object>>)request.getAttribute("notifications");String error=(String)request.getAttribute("error"),dashboard=(String)request.getAttribute("dashboard");%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Notifications - Sunrise Dental Clinic</title><style>
*{box-sizing:border-box}body{margin:0}.navbar{display:flex;justify-content:space-between;align-items:center}.navbar a{color:white;text-decoration:none;font-weight:bold}.container{max-width:900px;margin:38px auto;padding:0 20px}.box{padding:32px;background:white}.heading h1{margin:0 0 6px}.heading{margin-bottom:25px}.feed{display:grid;gap:12px}.notice{padding:18px;border:1px solid #dce9e8;border-left:5px solid #21a7a0;border-radius:10px;background:#fff}.notice.unread{background:#f1faf8}.notice-head{display:flex;justify-content:space-between;gap:18px}.notice h2{margin:0;color:#123047;font-size:18px}.notice time{color:#607583;font-size:13px;white-space:nowrap}.notice p{margin:9px 0 0;color:#405866;line-height:1.55}.badge{display:inline-flex;margin-top:10px;padding:4px 8px;color:#176b87;background:#e9f8f5;border-radius:999px;font-size:11px;font-weight:bold}.empty{padding:35px;color:#607583;background:#f4fbf9;border-radius:10px;text-align:center}.message{padding:13px;margin-bottom:18px}.back{display:block;margin-top:22px;text-align:center;text-decoration:none;font-weight:bold}@media(max-width:600px){.notice-head{flex-direction:column;gap:5px}.box{padding:23px 16px}}
</style><link rel="stylesheet" href="${pageContext.request.contextPath}/css/clinic-theme.css"></head><body><header class="navbar"><strong class="navbar-title">Sunrise Dental Clinic | <%=role%></strong><a href="<%=dashboard%>">Dashboard</a></header><main class="container"><section class="box"><div class="heading"><h1>Notifications</h1><p>Relevant clinic, appointment, payment and availability updates for your account.</p></div><%if(error!=null){%><div class="message error" role="alert"><%=error%></div><%}%><div class="feed"><%if(notices!=null&&!notices.isEmpty())for(Map<String,Object> notice:notices){%><article class="notice <%=Boolean.TRUE.equals(notice.get("read"))?"":"unread"%>"><div class="notice-head"><h2><%=notice.get("title")%></h2><time><%=notice.get("createdAt")%></time></div><p><%=notice.get("message")%></p><span class="badge"><%=notice.get("type")%></span></article><%}else{%><div class="empty">There are no relevant notifications yet.</div><%}%></div></section><a class="back" href="<%=dashboard%>">← Back to Dashboard</a></main></body></html>
