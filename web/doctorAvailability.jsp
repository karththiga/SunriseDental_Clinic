<%@page contentType="text/html" pageEncoding="UTF-8"%><%@page import="java.util.List"%><%@page import="java.util.Map"%>
<%
String username=(String)session.getAttribute("username"),role=(String)session.getAttribute("role");if(username==null||!"Dentist".equalsIgnoreCase(role)){response.sendRedirect("login.jsp");return;}
List<Map<String,Object>> schedules=(List<Map<String,Object>>)request.getAttribute("schedules"),leaves=(List<Map<String,Object>>)request.getAttribute("leaves");String[] days=(String[])request.getAttribute("days");String error=(String)request.getAttribute("error"),success=(String)request.getAttribute("success");
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>My Availability - Sunrise Dental Clinic</title><style>
*{box-sizing:border-box}body{margin:0}.navbar{display:flex;justify-content:space-between;align-items:center}.navbar a{color:white;text-decoration:none;font-weight:bold}.container{max-width:1050px;margin:38px auto;padding:0 20px}.box{padding:32px;background:white}.intro{margin-bottom:26px}.intro h1{margin:0 0 6px}.message{padding:13px;margin-bottom:18px;border-radius:9px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.panel{padding:23px;border:1px solid #dce9e8;border-radius:14px;background:#f8fcfb}.panel h2{margin:0 0 6px}.panel>p{margin-top:0;color:#607583}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field.full{grid-column:1/-1}.field label{display:block;margin-bottom:6px;color:#123047;font-weight:bold}.field input,.field select{width:100%;min-height:44px;padding:9px;border:1px solid #bfd3d3;background:white}.submit{width:100%;min-height:44px;margin-top:14px;border:0;font-weight:bold}.items{display:grid;gap:10px;margin-top:20px}.item{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:13px;background:white;border:1px solid #dce9e8;border-radius:10px}.item strong{display:block;color:#123047}.item span{color:#607583;font-size:14px}.delete{min-height:36px;padding:0 12px;border:0;color:#9d2638;background:#ffeaed;font-weight:bold;cursor:pointer}.empty{padding:14px;color:#607583;background:white;border-radius:9px;text-align:center}.note{margin-top:22px;padding:15px;color:#775300;background:#fff5d8;border-radius:9px}.back{display:block;margin-top:22px;text-align:center;text-decoration:none;font-weight:bold}@media(max-width:760px){.grid,.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.box{padding:23px 16px}}
</style><link rel="stylesheet" href="${pageContext.request.contextPath}/css/clinic-theme.css"></head><body><header class="navbar"><strong class="navbar-title">Sunrise Dental Clinic | Dentist</strong><a href="dentistDashboard.jsp">Dashboard</a></header><main class="container"><section class="box"><div class="intro"><h1>My Availability and Leave</h1><p>Maintain recurring visiting hours and block individual leave dates from live reservations.</p></div><%if(error!=null){%><div class="message error" role="alert"><%=error%></div><%}if(success!=null){%><div class="message success" role="status"><%=success%></div><%}%>
<div class="grid"><section class="panel"><h2>Weekly Visiting Hours</h2><p>Add or update each weekday you normally visit.</p><form action="${pageContext.request.contextPath}/DoctorAvailabilityServlet" method="post"><input type="hidden" name="action" value="saveSchedule"><div class="form-grid"><div class="field full"><label for="dayOfWeek">Weekday</label><select id="dayOfWeek" name="dayOfWeek" required><option value="">Select day</option><%if(days!=null)for(String day:days){String label=day.substring(0,1)+day.substring(1).toLowerCase();%><option value="<%=day%>"><%=label%></option><%}%></select></div><div class="field"><label for="availableFrom">From</label><input id="availableFrom" name="availableFrom" type="time" required></div><div class="field"><label for="availableTo">To</label><input id="availableTo" name="availableTo" type="time" required></div></div><button class="submit" type="submit">Save Visiting Hours</button></form><div class="items"><%if(schedules!=null&&!schedules.isEmpty())for(Map<String,Object> item:schedules){%><div class="item"><div><strong><%=item.get("day")%></strong><span><%=item.get("from")%> – <%=item.get("to")%></span></div><form action="${pageContext.request.contextPath}/DoctorAvailabilityServlet" method="post" onsubmit="return confirm('Remove availability for this weekday?');"><input type="hidden" name="action" value="deleteSchedule"><input type="hidden" name="dayOfWeek" value="<%=item.get("dayValue")%>"><button class="delete" type="submit">Remove</button></form></div><%}else{%><div class="empty">No recurring visiting hours configured.</div><%}%></div></section>
<section class="panel"><h2>Announce Leave</h2><p>Leave dates are immediately removed from patient and staff booking choices.</p><form action="${pageContext.request.contextPath}/DoctorAvailabilityServlet" method="post"><input type="hidden" name="action" value="addLeave"><div class="form-grid"><div class="field full"><label for="leaveDate">Leave date</label><input id="leaveDate" name="leaveDate" type="date" min="<%=request.getAttribute("minimumDate")%>" required></div><div class="field full"><label for="reason">Reason</label><input id="reason" name="reason" maxlength="255" placeholder="Training, personal leave, conference…" required></div></div><button class="submit" type="submit">Announce Leave</button></form><div class="items"><%if(leaves!=null&&!leaves.isEmpty())for(Map<String,Object> item:leaves){%><div class="item"><div><strong><%=item.get("date")%></strong><span><%=item.get("reason")%></span></div><form action="${pageContext.request.contextPath}/DoctorAvailabilityServlet" method="post" onsubmit="return confirm('Withdraw this leave announcement?');"><input type="hidden" name="action" value="removeLeave"><input type="hidden" name="leaveDate" value="<%=item.get("date")%>"><button class="delete" type="submit">Withdraw</button></form></div><%}else{%><div class="empty">No upcoming leave announced.</div><%}%></div></section></div><div class="note"><strong>Existing appointments:</strong> announcing leave blocks new bookings immediately. Patients with an existing appointment receive a notification so clinic staff can arrange rescheduling.</div></section><a class="back" href="dentistDashboard.jsp">← Back to Dentist Dashboard</a></main></body></html>
